# Connexion directe à Postgres (rôle postgres / service). En local : Supabase démarré par pnpm.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Types de tâches pris par ce worker, séparés par des virgules : estimate, discovery, prepare, emails, send, dummy
WORKER_KINDS=dummy
# Identifiant lisible du worker (nom d'hôte par défaut)
WORKER_ID=
# Secondes d'attente quand la file est vide
WORKER_IDLE_SECONDS=5
# Préparation des formulaires : captures d'écran déposées dans Supabase Storage (rôle service)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Délai maximal par site (secondes) avant de le classer inaccessible
PREPARE_TIMEOUT=100
