# Variables des robots sur le serveur : copier en `.env` à côté de docker-compose.yml et remplir.
# Base Supabase cloud (pooler en mode session, port 5432 : les robots gardent une connexion ouverte)
DATABASE_URL=postgresql://postgres.mqwpjzcpwibikjaiaybd:MOT_DE_PASSE_BASE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# API Supabase cloud (captures d'écran des formulaires)
SUPABASE_URL=https://mqwpjzcpwibikjaiaybd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Proxys DataImpulse pour Google Maps (sinon Google bloque après quelques dizaines de recherches)
PROXY_URL=http://UTILISATEUR:MOT_DE_PASSE@gw.dataimpulse.com:823
# Surveillant des robots (leadmaker_workers/watchdog.py) : clé Resend et adresse qui reçoit les alertes
RESEND_API_KEY=
ALERT_EMAIL=schemoul.gabriel@gmail.com
# Réglages
WORKER_IDLE_SECONDS=3
PREPARE_TIMEOUT=100
SITE_SOFT_DEADLINE=70
EMAILS_TIMEOUT=90
SCRAPE_DELAY=1.5
